@@ -23,6 +23,13 @@ import org.jetbrains.annotations.ApiStatus;
 @ApiStatus.NonExtendable
 public interface RegistryEventProvider<T, B extends RegistryBuilder<T>> {
 
+    // Nix start - Expose registry provider creation for Content System events
+    @ApiStatus.Internal
+    static <T, B extends RegistryBuilder<T>> RegistryEventProvider<T, B> create(final RegistryKey<T> registryKey) {
+        return RegistryEventProviderImpl.create(registryKey);
+    }
+    // Nix end - Expose registry provider creation for Content System events
+
     /**
      * Gets the event type for {@link RegistryEntryAddEvent} which is fired just before
