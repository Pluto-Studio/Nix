     }
     // Paper end
 
+    // Nix start - Add ItemType factories
+    @org.jetbrains.annotations.Contract(value = "_ -> new", pure = true)
+    public static @NotNull ItemStack of(final @NotNull ItemType type) {
+        return type.createItemStack();
+    }
+
+    @org.jetbrains.annotations.Contract(value = "_, _ -> new", pure = true)
+    public static @NotNull ItemStack of(final @NotNull ItemType type, final int amount) {
+        Preconditions.checkArgument(amount > 0, "amount must be greater than 0");
+        return type.createItemStack(amount);
+    }
+    // Nix end - Add ItemType factories
+
