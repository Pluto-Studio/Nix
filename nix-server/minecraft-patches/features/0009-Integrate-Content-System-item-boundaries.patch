+    // Nix start - project item-bearing entity data separately for each viewer
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    public static List<SynchedEntityData.DataValue<?>> projectEntityDataValues(
+        final List<SynchedEntityData.DataValue<?>> values, final ServerPlayer viewer
+    ) {
+        List<SynchedEntityData.DataValue<?>> projected = null;
+        for (int index = 0; index < values.size(); index++) {
+            final SynchedEntityData.DataValue<?> value = values.get(index);
+            if (value.value() instanceof ItemStack itemStack) {
+                if (projected == null) {
+                    projected = new ArrayList<>(values.size());
+                    projected.addAll(values.subList(0, index));
+                }
+                projected.add(new SynchedEntityData.DataValue(
+                    value.id(),
+                    value.serializer(),
+                    club.plutoproject.nix.contentsystem.ContentSystemServices.current().project(itemStack, viewer.getBukkitEntity())
+                ));
+            } else if (projected != null) {
+                projected.add(value);
+            }
+        }
+        return projected == null ? values : projected;
+    }
+
+    private static List<Pair<EquipmentSlot, ItemStack>> projectEquipmentSlots(
+        final List<Pair<EquipmentSlot, ItemStack>> slots, final ServerPlayer viewer
+    ) {
+        final List<Pair<EquipmentSlot, ItemStack>> projected = Lists.newArrayListWithCapacity(slots.size());
+        for (final Pair<EquipmentSlot, ItemStack> slot : slots) {
+            projected.add(Pair.of(
+                slot.getFirst(),
+                club.plutoproject.nix.contentsystem.ContentSystemServices.current().project(slot.getSecond(), viewer.getBukkitEntity())
+            ));
+        }
+        return projected;
+    }
+
+    public void sendEquipmentChanges(final List<Pair<EquipmentSlot, ItemStack>> slots, final boolean sanitize) {
+        for (final net.minecraft.server.network.ServerPlayerConnection connection : this.trackedPlayers) {
+            final ServerPlayer viewer = connection.getPlayer();
+            connection.send(new ClientboundSetEquipmentPacket(this.entity.getId(), projectEquipmentSlots(slots, viewer), sanitize));
+        }
+    }
+
+    // Nix start - resend current equipment to one tracked viewer
+    public void sendEquipmentChanges(final ServerPlayer viewer) {
+        if (!(this.entity instanceof LivingEntity livingEntity)) {
+            return;
+        }
+        final List<Pair<EquipmentSlot, ItemStack>> slots = Lists.newArrayList();
+        for (final EquipmentSlot slot : EquipmentSlot.VALUES) {
+            final ItemStack itemStack = livingEntity.getItemBySlot(slot);
+            if (!itemStack.isEmpty()) {
+                slots.add(Pair.of(slot, itemStack.copy()));
+            }
+        }
+        if (!slots.isEmpty()) {
+            viewer.connection.send(new ClientboundSetEquipmentPacket(this.entity.getId(), projectEquipmentSlots(slots, viewer), true));
+        }
+    }
+    // Nix end - resend current equipment to one tracked viewer
+    // Nix end - project item-bearing entity data separately for each viewer
