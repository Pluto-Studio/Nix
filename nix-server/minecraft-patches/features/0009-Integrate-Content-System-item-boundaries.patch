+        // Nix start - freeze component types before composing item types
+        bindBootstrappedTagsToEmpty(DATA_COMPONENT_TYPE);
+        io.papermc.paper.registry.PaperRegistryListenerManager.INSTANCE.runFreezeListeners(DATA_COMPONENT_TYPE.key(), STATIC_ACCESS_CONVERSIONS);
+        DATA_COMPONENT_TYPE.freeze();
+        // Nix end - freeze component types before composing item types
+
         for (Registry<?> registry : REGISTRY) {
+            // Nix start - component types were frozen before dependent item composition
+            if (registry == DATA_COMPONENT_TYPE) {
+                continue;
+            }
+            // Nix end - component types were frozen before dependent item composition
             bindBootstrappedTagsToEmpty(registry);
             io.papermc.paper.registry.PaperRegistryListenerManager.INSTANCE.runFreezeListeners(registry.key(), STATIC_ACCESS_CONVERSIONS); // Paper
             registry.freeze();
